<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SeptPaceAuto</RootNamespace>
    <AssemblyName>SeptPaceAuto.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le cœur métier reste interne ; seuls ses tests le voient. -->
    <InternalsVisibleTo Include="SeptPaceAuto.Tests" />
    <!-- Le collecteur héberge le cœur et voit donc ses types internes. -->
    <InternalsVisibleTo Include="SeptPaceAuto.Agent" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.2.3" />
  </ItemGroup>

</Project>
