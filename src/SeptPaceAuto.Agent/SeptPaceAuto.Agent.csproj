<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe : le collecteur vit sans console, donc sans fenêtre à fermer par mégarde. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SeptPaceAuto.Agent</RootNamespace>
    <AssemblyName>SeptPaceAuto.Agent</AssemblyName>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeptPaceAuto.Core\SeptPaceAuto.Core.csproj" />
  </ItemGroup>

</Project>
