{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "7pace auto",
  "mainBinaryName": "SeptPaceAuto.App",
  "version": "2.0.0",
  "identifier": "com.doriannx.septpaceauto",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "7pace auto",
        "width": 1100,
        "height": 640,
        "minWidth": 720,
        "minHeight": 380,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false,
        "windowEffects": { "effects": ["acrylic"] }
      },
      {
        "label": "widget",
        "url": "widget.html",
        "title": "7pace auto · widget",
        "width": 380,
        "height": 34,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
